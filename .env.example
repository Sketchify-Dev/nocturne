# ── Qwen (Alibaba Cloud DashScope, OpenAI-compatible endpoint) ──
# Leave these BLANK to run in DEMO MODE: the agent uses built-in mock data and
# needs zero API keys. Fill them in to switch on real Qwen decisions.
QWEN_API_KEY=
# International endpoint. For mainland China use https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ── Durable storage (optional, for 24/7 production) ──
# Leave BLANK for local dev: state persists to data/state.json on disk.
# In serverless production (Vercel), the disk is read-only and per-request, so
# set these to an Upstash Redis database (free tier) to keep the portfolio
# between ticks and let the agent run around the clock. Copy both values from
# the Upstash console's "REST API" section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── On-chain proof (optional) ──
# Read-only Solana JSON-RPC used to show real xStock mints and their recent
# transactions on the terminal. Leave BLANK to use the public mainnet node
# (rate limited); set a private endpoint (Helius, QuickNode, and similar) for a
# reliably live panel when recording the demo. Nocturne never sends a
# transaction; it only reads.
SOLANA_RPC_URL=

# ── Cron protection (optional) ──
# If set, GET /api/cron/tick requires a matching ?secret=... query param.
# Generate any long random string; you will paste the same value into the
# external scheduler's URL as ?secret=...
CRON_SECRET=
